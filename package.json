{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-codex-usage",
  "title": "Codex Usage",
  "description": "Enables you to see your weekly and monthly usage limits for Codex through Raycast",
  "icon": "extension-icon.png",
  "author": "TechSupportz",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "view-codex-usage",
      "title": "View Codex Usage",
      "description": "View Codex usage limits",
      "mode": "view",
      "preferences": [
        {
          "name": "dataScenario",
          "title": "Data Scenario",
          "description": "Choose live data or a static mock scenario for screenshots.",
          "type": "dropdown",
          "required": false,
          "default": "live",
          "data": [
            {
              "title": "Live Data",
              "value": "live"
            },
            {
              "title": "Healthy Usage",
              "value": "healthy"
            },
            {
              "title": "Busy Week",
              "value": "busy"
            },
            {
              "title": "Near Limit",
              "value": "near-limit"
            },
            {
              "title": "Fresh Account",
              "value": "fresh"
            }
          ]
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.15",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
